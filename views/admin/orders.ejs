<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>الطلبات - Admin AURA VEEX</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    .admin-layout { display: flex; min-height: 100vh; }
    .admin-sidebar { width: 220px; background: #1a1a1a; color: #fff; padding: 2rem 1rem; }
    .admin-sidebar h2 { font-size: 1.2rem; margin-bottom: 2rem; }
    .admin-sidebar a { display: block; color: #ccc; padding: 0.6rem 0; border-bottom: 1px solid #333; }
    .admin-sidebar a:hover { color: #fff; }
    .admin-content { flex: 1; padding: 2rem; background: #e9ecef; }
    .admin-content h1 { font-size: 1.8rem; margin-bottom: 1.5rem; text-align: right; }
    .toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; gap: 0.5rem; flex-wrap: wrap; }
    .order-card { background: #f7f7f7; border: 1px solid #d1d5db; border-radius: 12px; padding: 1.5rem; margin-bottom: 1rem; font-size: 1.1rem; display: flex; gap: 1rem; }
    .order-card .checkbox-col { flex-shrink: 0; padding-top: 0.3rem; }
    .order-card .checkbox-col input { width: 20px; height: 20px; cursor: pointer; }
    .order-card .card-main { flex: 1; min-width: 0; }
    .order-card-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; font-weight: 700; font-size: 1.15rem; }
    .order-card-body { color: #555; line-height: 2; font-size: 1.05rem; }
    .order-card-body span { color: #1a1a1a; }
    .order-card-footer { display: flex; justify-content: space-between; align-items: center; margin-top: 0.8rem; padding-top: 0.8rem; border-top: 1px solid #d1d5db; font-size: 1.1rem; }
    .badge { display: inline-block; padding: 0.3rem 1rem; border-radius: 20px; font-size: 0.95rem; font-weight: 600; }
    .badge-new { background: #e3f2fd; color: #1565c0; }
    .badge-call1 { background: #fff3e0; color: #e65100; }
    .badge-call2 { background: #fff3e0; color: #e65100; }
    .badge-confirmed { background: #e8f5e9; color: #2e7d32; }
    .badge-cancelled { background: #fbe9e7; color: #c62828; }
    .status-form { display: flex; gap: 0.5rem; align-items: center; }
    .status-form select { padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 6px; font-size: 1rem; background: #f0f0f0; }
    .tracking-form { display: flex; gap: 0.5rem; align-items: center; }
    .tracking-form input { flex: 1; padding: 0.5rem; border: 1px solid #d1d5db; border-radius: 6px; font-size: 1rem; background: #fff; direction: ltr; text-align: left; }
    .tracking-section { margin: 0.5rem 0; padding: 0.5rem 0; border-top: 1px dashed #d1d5db; }
    .btn-del { background: none; border: none; color: #c62828; cursor: pointer; font-size: 1rem; padding: 0.3rem 0.6rem; border-radius: 6px; }
    .btn-del:hover { background: #fbe9e7; }
    .btn-batch-del { background: #c62828; color: #fff; border: none; border-radius: 8px; padding: 0.6rem 1.5rem; font-size: 1rem; cursor: pointer; }
    .btn-batch-del:hover { background: #b71c1c; }
    .select-all-label { display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-size: 1rem; }
    .select-all-label input { width: 18px; height: 18px; cursor: pointer; }
  </style>
</head>
<body>
  <div class="admin-layout">
    <div class="admin-sidebar">
      <h2>AURA VEEX</h2>
      <a href="/admin">📊 المنتجات</a>
      <a href="/admin/orders">📋 الطلبات</a>
      <a href="/admin/products/add">➕ إضافة منتج</a>
      <a href="/">🏠 المتجر</a>
      <a href="/admin/logout">🚪 خروج</a>
    </div>
    <div class="admin-content">
      <h1>📋 الطلبات (<%= orders.length %>)</h1>

      <% if (orders.length > 0) { %>
          <div class="toolbar">
            <label class="select-all-label">
              <input type="checkbox" id="selectAll" onclick="document.querySelectorAll('.order-checkbox').forEach(c => c.checked = this.checked)">
              تحديد الكل
            </label>
            <button type="button" class="btn-batch-del" onclick="batchDelete()">🗑️ حذف المحدد</button>
          </div>

          <% orders.forEach(o => { %>
            <div class="order-card">
              <div class="checkbox-col">
                <input type="checkbox" value="<%= o.id %>" class="order-checkbox">
              </div>
              <div class="card-main">
                <div class="order-card-header">
                  <span><%= o.id %></span>
                  <span class="badge badge-<%=
                    o.status === 'جديد' ? 'new' :
                    o.status === 'اتصال 1' ? 'call1' :
                    o.status === 'اتصال 2' ? 'call2' :
                    o.status === 'مؤكد' ? 'confirmed' :
                    o.status === 'ملغي' ? 'cancelled' : 'new'
                  %>"><%= o.status %></span>
                </div>
                <div class="order-card-body">
                  <div>👤 <%= o.firstName %> <%= o.lastName %></div>
                  <div>📞 <%= o.phone %></div>
                  <div>📍 <%= o.address %>, <%= o.commune ? o.commune + ', ' : '' %><span><%= o.wilaya %></span></div>
                  <div>📦 <% o.items.forEach(i => { %><%= i.name %> x<%= i.quantity %> <% }) %></div>
                </div>
                <div class="tracking-section">
                  <form action="/admin/orders/tracking" method="POST" class="tracking-form">
                    <input type="hidden" name="id" value="<%= o.id %>">
                    <input type="text" name="trackingCode" value="<%= o.trackingCode || '' %>" placeholder="رمز التتبع (Yalidine)">
                    <button type="submit" class="btn-sm">حفظ</button>
                  </form>
                </div>
                <div class="order-card-footer">
                  <span>💰 <%= o.subtotal ? o.subtotal.toLocaleString() + ' د.ج' : '' %><%= o.deliveryPrice ? ' + توصيل ' + o.deliveryPrice.toLocaleString() + ' د.ج' : '' %> = <%= o.total.toLocaleString() %> د.ج</span>
                  <div style="display:flex;gap:0.5rem;align-items:center;">
                    <form action="/admin/orders/status" method="POST" class="status-form">
                      <input type="hidden" name="id" value="<%= o.id %>">
                      <select name="status">
                        <% statuses.forEach(s => { %>
                          <option value="<%= s %>" <%= o.status === s ? 'selected' : '' %>><%= s %></option>
                        <% }) %>
                      </select>
                      <button type="submit" class="btn-sm">تحديث</button>
                    </form>
                    <form action="/admin/orders/delete/<%= o.id %>" method="POST" onsubmit="return confirm('حذف الطلب <%= o.id %>؟')">
                      <button type="submit" class="btn-del">🗑️</button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
      <% } else { %>
        <p style="text-align:center;color:#888;padding:3rem 0;">لا توجد طلبات بعد</p>
      <% } %>
    </div>
  </div>
  <script>
    function batchDelete() {
      const checked = Array.from(document.querySelectorAll('.order-checkbox:checked')).map(c => c.value);
      if (checked.length === 0) { alert('اختر طلبات للحذف أولاً.'); return; }
      if (!confirm('حذف ' + checked.length + ' طلب؟ هذا لا رجع فيه.')) return;
      const f = document.createElement('form');
      f.method = 'POST';
      f.action = '/admin/orders/delete-batch';
      checked.forEach(id => { const i = document.createElement('input'); i.type = 'hidden'; i.name = 'ids'; i.value = id; f.appendChild(i); });
      document.body.appendChild(f);
      f.submit();
    }
  </script>
</body>
</html>