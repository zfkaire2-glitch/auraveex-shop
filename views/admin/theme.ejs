<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <div class="admin-layout">
    <div class="admin-sidebar">
      <h2>AURA VEEX</h2>
      <a href="/admin">📊 المنتجات</a>
      <a href="/admin/orders">📋 الطلبات</a>
      <a href="/admin/stats">📈 الإحصائيات</a>
      <a href="/admin/products/add">➕ إضافة منتج</a>
      <a href="/admin/theme">🎨 الثيم</a>
      <a href="/admin/builder">🛠 البناء</a>
      <a href="/">🏠 المتجر</a>
      <a href="/admin/logout">🚪 خروج</a>
    </div>
    <div class="admin-content">
      <h1>🎨 تخصيص الثيم</h1>
      <% if (success) { %><div class="theme-success"><%= success %></div><% } %>
      <form action="/admin/theme" method="POST" class="theme-form">
        <div class="theme-section">
          <h3>العام</h3>
          <div class="theme-row">
            <div class="theme-field">
              <label>اسم الثيم</label>
              <input type="text" name="theme_label" value="<%= theme.label %>">
            </div>
            <div class="theme-field">
              <label>نوع الشعار</label>
              <select name="logo_type" style="width:100%;padding:0.5rem 0.7rem;border:1.5px solid #d1d5db;border-radius:6px;font-size:0.9rem;">
                <option value="text" <%= theme.logo.type === 'text' ? 'selected' : '' %>>نص</option>
                <option value="image" <%= theme.logo.type === 'image' ? 'selected' : '' %>>صورة</option>
              </select>
            </div>
          </div>
          <div class="theme-row">
            <div class="theme-field">
              <label>نص الشعار</label>
              <input type="text" name="logo_text" value="<%= theme.logo.text %>">
            </div>
            <div class="theme-field">
              <label>رابط الشعار (صورة)</label>
              <input type="text" name="logo_image" value="<%= theme.logo.image %>" placeholder="/uploads/logo.png">
            </div>
          </div>
          <div class="theme-row">
            <div class="theme-field">
              <label>أيقونة المتصفح (favicon)</label>
              <input type="text" name="favicon" value="<%= theme.favicon %>">
            </div>
            <div class="theme-field">
              <label>صورة الهيرو (خلفية)</label>
              <input type="text" name="hero_image" value="<%= theme.hero_image %>" placeholder="/uploads/hero-eagle.jpg">
            </div>
          </div>
        </div>

        <div class="theme-section">
          <h3>الخطوط</h3>
          <div class="theme-row">
            <div class="theme-field">
              <label>خط النصوص (body)</label>
              <input type="text" name="font_body" value="<%= theme.fonts.body %>">
            </div>
            <div class="theme-field">
              <label>خط العناوين (heading)</label>
              <input type="text" name="font_heading" value="<%= theme.fonts.heading %>">
            </div>
          </div>
          <div class="theme-row">
            <div class="theme-field">
              <label>حجم الخط الأساسي</label>
              <input type="text" name="font_size_base" value="<%= theme.fonts.size_base %>">
            </div>
            <div class="theme-field">
              <label>حجم خط العناوين</label>
              <input type="text" name="font_size_heading" value="<%= theme.fonts.size_heading %>">
            </div>
          </div>
        </div>

        <div class="theme-tabs">
          <div class="theme-tab active" onclick="switchTab('light', this)">☀️ الوضع النهاري</div>
          <div class="theme-tab" onclick="switchTab('dark', this)">🌙 الوضع الليلي</div>
        </div>

        <div id="tab-light" class="theme-tab-content active">
          <div class="theme-section">
            <h3>الألوان — الوضع النهاري</h3>
            <div class="theme-row">
              <div class="theme-field"><label>خلفية الصفحة</label><input type="color" name="light_bg_primary" value="<%= theme.colors.light.bg_primary %>"></div>
              <div class="theme-field"><label>خلفية البطاقات</label><input type="color" name="light_bg_card" value="<%= theme.colors.light.bg_card %>"></div>
            </div>
            <div class="theme-row">
              <div class="theme-field"><label>لون النص الرئيسي</label><input type="color" name="light_text_primary" value="<%= theme.colors.light.text_primary %>"></div>
              <div class="theme-field"><label>لون النص الثانوي</label><input type="color" name="light_text_secondary" value="<%= theme.colors.light.text_secondary %>"></div>
            </div>
            <div class="theme-row">
              <div class="theme-field"><label>لون النص الخافت</label><input type="color" name="light_text_muted" value="<%= theme.colors.light.text_muted %>"></div>
              <div class="theme-field"><label>لون الحدود</label><input type="color" name="light_border_light" value="<%= theme.colors.light.border_light %>"></div>
            </div>
            <div class="theme-row">
              <div class="theme-field"><label>اللون الأساسي (accent)</label><input type="color" name="light_accent" value="<%= theme.colors.light.accent %>"></div>
              <div class="theme-field"><label>اللون الأساسي (hover)</label><input type="color" name="light_accent_hover" value="<%= theme.colors.light.accent_hover %>"></div>
            </div>
            <div class="theme-row">
              <div class="theme-field"><label>خلفية الشريط العلوي (navbar)</label><input type="color" name="light_navbar_bg" value="<%= theme.colors.light.navbar_bg %>"></div>
              <div class="theme-field"><label>لون نص الشريط العلوي</label><input type="color" name="light_navbar_text" value="<%= theme.colors.light.navbar_text %>"></div>
            </div>
            <div class="theme-row">
              <div class="theme-field"><label>لون نص الشريط (hover)</label><input type="color" name="light_navbar_text_hover" value="<%= theme.colors.light.navbar_text_hover %>"></div>
              <div class="theme-field"><label>خلفية الفوتر</label><input type="color" name="light_footer_bg" value="<%= theme.colors.light.footer_bg %>"></div>
            </div>
            <div class="theme-row">
              <div class="theme-field"><label>نصف قطر الزوايا</label><input type="text" name="light_radius" value="<%= theme.colors.light.radius %>"></div>
              <div class="theme-field"><label>نصف قطر الزوايا الصغير</label><input type="text" name="light_radius_sm" value="<%= theme.colors.light.radius_sm %>"></div>
            </div>
          </div>
        </div>

        <div id="tab-dark" class="theme-tab-content">
          <div class="theme-section">
            <h3>الألوان — الوضع الليلي</h3>
            <div class="theme-row">
              <div class="theme-field"><label>خلفية الصفحة</label><input type="color" name="dark_bg_primary" value="<%= theme.colors.dark.bg_primary %>"></div>
              <div class="theme-field"><label>خلفية البطاقات</label><input type="color" name="dark_bg_card" value="<%= theme.colors.dark.bg_card %>"></div>
            </div>
            <div class="theme-row">
              <div class="theme-field"><label>لون النص الرئيسي</label><input type="color" name="dark_text_primary" value="<%= theme.colors.dark.text_primary %>"></div>
              <div class="theme-field"><label>لون النص الثانوي</label><input type="color" name="dark_text_secondary" value="<%= theme.colors.dark.text_secondary %>"></div>
            </div>
            <div class="theme-row">
              <div class="theme-field"><label>لون النص الخافت</label><input type="color" name="dark_text_muted" value="<%= theme.colors.dark.text_muted %>"></div>
              <div class="theme-field"><label>لون الحدود</label><input type="color" name="dark_border_light" value="<%= theme.colors.dark.border_light %>"></div>
            </div>
            <div class="theme-row">
              <div class="theme-field"><label>اللون الأساسي (accent)</label><input type="color" name="dark_accent" value="<%= theme.colors.dark.accent %>"></div>
              <div class="theme-field"><label>اللون الأساسي (hover)</label><input type="color" name="dark_accent_hover" value="<%= theme.colors.dark.accent_hover %>"></div>
            </div>
            <div class="theme-row">
              <div class="theme-field"><label>خلفية الشريط العلوي</label><input type="color" name="dark_navbar_bg" value="<%= theme.colors.dark.navbar_bg %>"></div>
              <div class="theme-field"><label>لون نص الشريط العلوي</label><input type="color" name="dark_navbar_text" value="<%= theme.colors.dark.navbar_text %>"></div>
            </div>
            <div class="theme-row">
              <div class="theme-field"><label>لون نص الشريط (hover)</label><input type="color" name="dark_navbar_text_hover" value="<%= theme.colors.dark.navbar_text_hover %>"></div>
              <div class="theme-field"><label>خلفية الفوتر</label><input type="color" name="dark_footer_bg" value="<%= theme.colors.dark.footer_bg %>"></div>
            </div>
            <div class="theme-row">
              <div class="theme-field"><label>نصف قطر الزوايا</label><input type="text" name="dark_radius" value="<%= theme.colors.dark.radius %>"></div>
              <div class="theme-field"><label>نصف قطر الزوايا الصغير</label><input type="text" name="dark_radius_sm" value="<%= theme.colors.dark.radius_sm %>"></div>
            </div>
          </div>
        </div>

        <div class="theme-actions">
          <button type="submit" class="btn-save">💾 حفظ الثيم</button>
          <a href="/" class="btn-reset" style="display:inline-block;padding:0.8rem 2rem;border-radius:8px;text-decoration:none;font-weight:700;">👁️ معاينة المتجر</a>
        </div>
      </form>
    </div>
  </div>
  <script>
    function switchTab(tab, btn) {
      document.querySelectorAll('.theme-tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.theme-tab-content').forEach(t => t.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('tab-' + tab).classList.add('active');
    }
  </script>
</body>
</html>
