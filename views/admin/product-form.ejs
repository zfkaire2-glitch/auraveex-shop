<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <%- include('../partials/head') %>
</head>
<body>
  <div class="admin-layout">
    <div class="admin-sidebar">
      <h2>AURA VEEX</h2>
      <a href="/admin">📊 المنتجات</a>
      <a href="/admin/products/add">➕ إضافة منتج</a>
      <a href="/admin/theme">🎨 الثيم</a>
      <a href="/admin/builder">🛠 البناء</a>
      <a href="/">🏠 المتجر</a>
      <a href="/admin/logout">🚪 خروج</a>
    </div>
    <div class="admin-content">
      <h1><%= product ? '✏️ تعديل المنتج' : '➕ إضافة منتج جديد' %></h1>
      <form action="<%= product ? '/admin/products/edit/' + product.id : '/admin/products/add' %>" method="POST" enctype="multipart/form-data" class="product-form">
        <label>الاسم</label>
        <input type="text" name="name" value="<%= product ? product.name : '' %>" required>

        <label>السعر (د.ج)</label>
        <input type="number" name="price" value="<%= product ? product.price : '' %>" required>

        <label>السعر القديم (اختياري)</label>
        <input type="number" name="oldPrice" value="<%= product && product.oldPrice ? product.oldPrice : '' %>">

        <label>القسم</label>
        <input type="text" name="category" value="<%= product ? product.category : '' %>" required>

        <label>الوصف</label>
        <textarea name="description" rows="4" required><%= product ? product.description : '' %></textarea>

        <label>المقاسات (مفصولة بفاصلة)</label>
        <input type="text" name="sizes" value="<%= product ? product.sizes.join(', ') : 'S, M, L, XL, XXL' %>">
        <p class="hint">مثال: S, M, L, XL, XXL</p>

        <label>الألوان (مفصولة بفاصلة)</label>
        <input type="text" name="colors" value="<%= product ? product.colors.join(', ') : '' %>">
        <p class="hint">مثال: أسود, أبيض, رمادي</p>

        <label>الصور (اختر عدة)</label>
        <input type="file" name="images" accept="image/*" multiple>
        <% if (product && product.images && product.images.length > 0) { %>
          <p style="margin-bottom:1rem">الحالية:
            <% product.images.forEach(img => { %>
              <img src="<%= img %>" style="width:60px;height:60px;object-fit:cover;border-radius:6px;vertical-align:middle;margin-left:4px;">
            <% }) %>
          </p>
        <% } %>

        <button type="submit" class="btn"><%= product ? '💾 حفظ التعديلات' : '➕ إضافة المنتج' %></button>
        <a href="/admin" class="btn" style="background:#666;margin-right:0.5rem">❌ إلغاء</a>
      </form>
    </div>
  </div>
</body>
</html>
