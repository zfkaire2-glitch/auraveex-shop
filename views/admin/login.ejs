<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <%- include('../partials/head') %>
  <style>
    .admin-login { max-width: 450px; margin: 6rem auto; padding: 2.5rem; background: #f7f7f7; border: 1px solid #d1d5db; border-radius: 12px; text-align: center; }
    .admin-login h1 { margin-bottom: 1.5rem; font-size: 1.8rem; }
    .admin-login input { width: 100%; padding: 0.9rem; margin-bottom: 1rem; border: 1px solid #d1d5db; border-radius: 8px; font-size: 1.1rem; background: #f0f0f0; }
    .error { color: #d32f2f; margin-bottom: 1rem; font-size: 1rem; }
  </style>
</head>
<body>
  <main>
    <div class="admin-login">
      <h1>🔐 AURA VEEX — Admin</h1>
      <% if (error) { %><p class="error"><%= error %></p><% } %>
      <form action="/admin/login" method="POST">
        <input type="password" name="password" placeholder="كلمة السر" required>
        <button type="submit" class="btn" style="width:100%">دخول</button>
      </form>
    </div>
  </main>
</body>
</html>
