<section class="section" id="section-<%= section.id %>" data-section-id="<%= section.id %>" data-section-type="image_banner">
  <a href="<%= section.settings.link || '#' %>" class="image-banner-link">
    <img src="<%= section.settings.image %>" alt="<%= section.settings.alt || '' %>" style="width:100%;border-radius:var(--radius-lg);display:block">
  </a>
</section>
