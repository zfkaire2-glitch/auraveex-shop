<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>
  <main class="section">
    <div class="auth-page">
      <h1>إنشاء حساب</h1>
      <p class="sub">انضم إلينا لتتبع طلباتك وحفظ عناوينك</p>
      <div class="auth-card">
        <% if (error) { %><div class="error"><%= error %></div><% } %>
        <form method="POST" action="/signup">
          <div class="auth-row">
            <div class="form-group">
              <label>الاسم</label>
              <input type="text" name="firstName" placeholder="محمد" required>
            </div>
            <div class="form-group">
              <label>اللقب</label>
              <input type="text" name="lastName" placeholder="أحمد">
            </div>
          </div>
          <div class="form-group">
            <label>رقم الهاتف</label>
            <input type="tel" name="phone" placeholder="0555123456" required dir="ltr" style="text-align:left">
          </div>
          <div class="form-group">
            <label>كلمة السر</label>
            <input type="password" name="password" placeholder="أدخل كلمة السر" required>
          </div>
          <button type="submit" class="btn">إنشاء الحساب</button>
        </form>
        <div class="link">لديك حساب؟ <a href="/login">تسجيل الدخول</a></div>
      </div>
    </div>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
