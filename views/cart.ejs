<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>
  <main class="section">
    <h1>سلة التسوق</h1>
    <% if (cart.length === 0) { %>
      <div class="empty-cart">
        <p>سلتك فارغة</p>
        <a href="/products" class="btn">تسوق الآن</a>
      </div>
    <% } else { %>
      <div class="cart-items">
        <% cart.forEach(item => { %>
          <div class="cart-item">
            <img src="<%= item.image %>" alt="<%= item.name %>">
            <div class="cart-item-info">
              <h3><%= item.name %></h3>
              <p>المقاس: <%= item.size %></p>
              <p><%= item.price.toLocaleString() %> د.ج</p>
            </div>
            <form action="/cart/update" method="POST" class="qty-form">
              <input type="hidden" name="id" value="<%= item.id %>">
              <input type="hidden" name="size" value="<%= item.size %>">
              <input type="number" name="quantity" value="<%= item.quantity %>" min="0" class="qty-input">
              <button type="submit" class="btn-sm">تحديث</button>
            </form>
            <div class="item-total">
              <%= (item.price * item.quantity).toLocaleString() %> د.ج
            </div>
          </div>
        <% }) %>
      </div>
      <div class="cart-summary">
        <div class="cart-total">
          <span>المجموع:</span>
          <span><%= subtotal.toLocaleString() %> د.ج</span>
        </div>
        <a href="/checkout" class="btn btn-lg">إتمام الشراء</a>
      </div>
    <% } %>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
