<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>طلباتي - AURA VEEX</title>
  <link rel="stylesheet" href="/style.css">
  <style>
    .badge { display: inline-block; padding: 0.25rem 1rem; border-radius: 20px; font-size: 0.9rem; font-weight: 600; }
    .badge-new { background: #e3f2fd; color: #1565c0; }
    .badge-call1 { background: #fff3e0; color: #e65100; }
    .badge-call2 { background: #fff3e0; color: #e65100; }
    .badge-confirmed { background: #e8f5e9; color: #2e7d32; }
    .badge-cancelled { background: #fbe9e7; color: #c62828; }
    .track-steps { display: flex; flex-direction: column; gap: 0.4rem; }
    .track-step { display: flex; align-items: center; gap: 0.6rem; padding: 0.4rem 0.6rem; border-radius: 6px; font-size: 0.9rem; }
    .track-step.done { background: #e8f5e9; color: #2e7d32; }
    .track-step.pending { background: #f5f5f5; color: #999; }
    .track-step .icon { font-size: 1rem; }
    .track-step .label { flex: 1; }
    .track-step .date { font-size: 0.8rem; color: #666; direction: ltr; }
  </style>
</head>
<body>
  <%- include('partials/header') %>
  <main class="section">
    <h1>طلباتي</h1>
    <% if (orders.length === 0) { %>
      <p class="empty">لا توجد طلبات بعد.</p>
    <% } else { %>
      <% orders.forEach(order => { %>
        <div class="order-card">
          <div class="order-header">
            <span>الطلب: <%= order.id %></span>
            <span class="badge badge-<%=
              order.status === 'جديد' ? 'new' :
              order.status === 'اتصال 1' ? 'call1' :
              order.status === 'اتصال 2' ? 'call2' :
              order.status === 'مؤكد' ? 'confirmed' :
              order.status === 'ملغي' ? 'cancelled' : 'new'
            %>"><%= order.status %></span>
          </div>
          <div class="order-body">
            <div style="margin-bottom:0.3rem;">📍 <span><%= order.address %><%= order.commune ? '، ' + order.commune : '' %></span></div>
            <% order.items.forEach(item => { %>
              <div><%= item.name %> x<%= item.quantity %> — <%= (item.price * item.quantity).toLocaleString() %> د.ج</div>
            <% }) %>
          </div>
            <div class="order-footer">
            <span><%= order.deliveryPrice ? 'المجموع (مع التوصيل): ' : 'المجموع: ' %><%= order.total.toLocaleString() %> د.ج</span>
            <% if (order.trackingCode) { %>
              <div style="margin-top:0.8rem;">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem;">
                  <strong style="font-size:0.95rem;">📦 حالة التتبع</strong>
                  <a href="https://track.yalidine.app/<%= order.trackingCode %>" target="_blank" style="font-size:0.85rem;color:#1565c0;">فتح في ياليدين ↗</a>
                </div>
                <div id="ts-<%= order.id %>" style="text-align:center;padding:1rem;background:#f0f0f0;border-radius:8px;font-size:0.9rem;color:#888;">جاري التحميل...</div>
                <iframe id="tf-<%= order.id %>" src="https://track.yalidine.app/<%= order.trackingCode %>" style="display:none;width:100%;height:260px;border:1px solid #e0e0e0;border-radius:8px;background:#fff;" sandbox="allow-scripts allow-same-origin"></iframe>
              </div>
            <% } %>
          </div>
        </div>
      <% }) %>
    <% } %>
  </main>
  <%- include('partials/footer') %>
  <script>
    <% orders.filter(o => o.trackingCode).forEach(order => { %>
    (async function() {
      const code = <%- JSON.stringify(order.trackingCode) %>;
      const statusEl = document.getElementById('ts-<%= order.id %>');
      const fallbackEl = document.getElementById('tf-<%= order.id %>');
      try {
        const res = await fetch('/api/tracking/' + code);
        const json = await res.json();
        if (json.available && json.data) {
          const d = json.data;
          let steps, current;
          if (d.history) { steps = d.history; current = steps.find(s => s.status === 'current') || steps[steps.length - 1]; }
          else if (d.tracking) { steps = d.tracking; current = steps[steps.length - 1]; }
          if (d.etat) current = { label: d.etat };
          statusEl.innerHTML = '';
          statusEl.style.textAlign = 'right';
          statusEl.style.padding = '0.8rem';
          statusEl.style.background = '#f9f9f9';
          if (steps && steps.length) {
            const container = document.createElement('div');
            container.className = 'track-steps';
            steps.forEach(s => {
              const div = document.createElement('div');
              div.className = 'track-step ' + (s.status === 'done' || s.status === 'current' ? 'done' : 'pending');
              div.innerHTML = '<span class="icon">' + (s.status === 'done' ? '✅' : s.status === 'current' ? '🔄' : '⏳') + '</span><span class="label">' + (s.title || s.label || s.etat || s) + '</span><span class="date">' + (s.date || s.updated_at || '') + '</span>';
              container.appendChild(div);
            });
            statusEl.appendChild(container);
          } else if (current) {
            statusEl.innerHTML = '<div style="text-align:center;font-size:1.1rem;"><div style="font-size:2rem;margin-bottom:0.3rem;">📦</div><div style="font-weight:700;color:#1a1a1a;">' + (current.title || current.label || current.etat || 'غير معروف') + '</div></div>';
          } else { fallbackEl.style.display = 'block'; statusEl.style.display = 'none'; }
        } else { fallbackEl.style.display = 'block'; statusEl.style.display = 'none'; }
      } catch(e) { fallbackEl.style.display = 'block'; statusEl.style.display = 'none'; }
    })();
    <% }) %>
  </script>
</body>
</html>
